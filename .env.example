# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# ── Phase 0/1 ────────────────────────────────────────────
ELEVENLABS_API_KEY=

# Required: free-tier accounts can't call ElevenLabs' shared "voice library"
# voices via the API (402 payment_required). Add a voice to your own account
# (Voices -> Voice Library -> "Add to my voices") and put its voice_id here.
# List voices already in your account: curl -H "xi-api-key: $ELEVENLABS_API_KEY" https://api.elevenlabs.io/v1/voices
TTS_VOICE_ID=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=shui-wg-renders
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

# ── Phase 2 ──────────────────────────────────────────────
# Your Firestore-only Firebase project ID from Phase 0 (e.g. shui-wg-a1b2c).
FIRESTORE_PROJECT_ID=

# Local dev auth: run `gcloud auth application-default login` once on your
# machine instead of setting this. Only set this (a path to a service
# account JSON) for deployed environments, via Secret Manager — never commit
# the file itself.
# GOOGLE_APPLICATION_CREDENTIALS=

PORT=8080

# Optional shared secret for the local /internal/render endpoint. Leave
# unset for local dev — it's only meaningful once deployed, where Cloud
# Tasks' own OIDC-authenticated request is the real protection.
# INTERNAL_RENDER_SECRET=

# Leave CLOUD_TASKS_QUEUE unset for local dev — the server falls back to an
# in-process DevQueue automatically. Set all of these together, only at
# deploy time, to switch to real Cloud Tasks:
# CLOUD_TASKS_LOCATION=us-central1
# CLOUD_TASKS_QUEUE=shui-wg-render-queue
# INTERNAL_RENDER_URL=https://<cloud-run-url>/internal/render
# CLOUD_TASKS_INVOKER_SERVICE_ACCOUNT=

# ── Phase 3 ──────────────────────────────────────────────
# Required for the narrationScript-only path (the LLM scene planner).
# Not needed if you only ever submit pre-authored `scenes`.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Phase 4 ──────────────────────────────────────────────
# Required for any documentReveal/fullBleedGraphic action that uses
# imageConcept (not needed if every image is supplied directly as imageUrl).
# At least one of the two is required; both recommended so
# render-illustration-comparison.ts can actually compare them.
RECRAFT_API_KEY=
FLUX_API_KEY=              # from fal.ai or your chosen Flux aggregator
IMAGE_PROVIDER=recraft     # default provider when a request doesn't specify one
